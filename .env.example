# Required for stdio / local tools
MEMOO_API_KEY=moo_sk_your_key_here

# Optional — default namespace when tool args omit namespace
MEMOO_NAMESPACE=my-namespace

# Optional — Memoo REST base URL
MEMOO_BASE_URL=https://memoo.hinha.web.id

# Optional — API key prefix (default moo_sk)
MEMOO_API_KEY_PREFIX=moo_sk

# Optional — upstream timeout (Go-style 600s or ms). Default 300000ms
MEMOO_TIMEOUT=600s
# MEMOO_TIMEOUT_MS=300000

# Optional — HTTP serve bind (path is fixed at /mcp)
MEMOO_HOST=127.0.0.1
MEMOO_PORT=8787

# Optional — log level: debug|info|warn|error
MEMOO_LOG_LEVEL=info
